{
  "name": "unified-appscript-mcp",
  "version": "0.1.0",
  "description": "Unified MCP server for Google Apps Script and Google Workspace with automatic browser OAuth.",
  "type": "module",
  "bin": { "unified-appscript-mcp": "dist/index.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "keywords": ["mcp", "google-apps-script", "google-workspace", "oauth2", "automation"],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/CerisonAutomation/unified-appscript-mcp.git" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "open": "^10.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
